{
	"name": "gitface",
	"version": "0.7.0",
	"description": "A simple CLI tool to change your “face” in Git.",
	"type": "module",
	"license": "MIT",
	"files": [
		"dist"
	],
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc --noEmit && tsdown",
		"dev": "tsdown --watch",
		"test": "vitest run --silent --coverage",
		"test:ui": "vitest --ui",
		"lint": "biome check",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.4",
		"@types/node": "^25.3.3",
		"@types/react": "^19.2.14",
		"@vitest/coverage-v8": "4.0.18",
		"@vitest/ui": "4.0.18",
		"bumpp": "^10.4.1",
		"tsdown": "^0.20.3",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	},
	"bin": {
		"gitface": "./dist/index.mjs"
	},
	"packageManager": "pnpm@10.30.3",
	"dependencies": {
		"chalk": "^5.6.2",
		"commander": "^14.0.3",
		"ink": "^6.8.0",
		"ink-select-input": "^6.2.0",
		"ink-text-input": "^6.0.0",
		"react": "^19.2.4",
		"simple-git": "^3.32.3",
		"string-width": "^8.2.0",
		"zod": "^4.3.6"
	}
}
