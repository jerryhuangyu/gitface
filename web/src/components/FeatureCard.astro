---
/*
 * FeatureCard — Cloudflare 式功能卡片：icon + 標題 + 描述（+ 可選連結）。
 *
 * 比 Starlight 內建 <Card> 多：整卡可點（給 href 時）、icon 用 accent 色、
 * hover 抬升 + accent 邊框。放進 Starlight <CardGrid> 或自行排版皆可。
 *
 * 用法：
 *   <FeatureCard title="自動切換" icon="setting" href="/gitface/rules/">
 *     資料夾規則讓 repo 依所在位置自動用對身分。
 *   </FeatureCard>
 */
import { Icon } from "@astrojs/starlight/components";
import type { StarlightIcon } from "@astrojs/starlight/types";

interface Props {
	title: string;
	icon?: StarlightIcon;
	href?: string;
}
const { title, icon, href } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag class="gf-feature-card" href={href} data-linked={href ? "" : undefined}>
	{icon && <Icon name={icon} class="gf-feature-card__icon" size="1.5rem" />}
	<p class="gf-feature-card__title">{title}</p>
	<div class="gf-feature-card__body"><slot /></div>
	{
		href && (
			<span class="gf-feature-card__arrow" aria-hidden="true">
				→
			</span>
		)
	}
</Tag>

<style>
	.gf-feature-card {
		position: relative;
		display: block;
		padding: 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: var(--radius-card, 0.75rem);
		background: var(--sl-color-black);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}

	.gf-feature-card[data-linked]:hover {
		border-color: var(--sl-color-accent);
		transform: translateY(-2px);
		/* 分層陰影：近影定形 + 遠影擴散，比單層更自然 */
		box-shadow:
			0 1px 2px rgb(0 0 0 / 0.08),
			0 6px 20px rgb(0 0 0 / 0.12);
	}

	.gf-feature-card__icon {
		color: var(--sl-color-accent);
		margin-bottom: 0.625rem;
	}

	.gf-feature-card__title {
		margin: 0 0 0.375rem;
		font-size: var(--sl-text-lg);
		font-weight: 600;
		color: var(--sl-color-white);
	}

	.gf-feature-card__body {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		line-height: 1.5;
	}

	.gf-feature-card__arrow {
		display: inline-block;
		margin-top: 0.75rem;
		color: var(--sl-color-accent);
		transition: transform 0.15s ease;
	}

	.gf-feature-card[data-linked]:hover .gf-feature-card__arrow {
		transform: translateX(3px);
	}
</style>
