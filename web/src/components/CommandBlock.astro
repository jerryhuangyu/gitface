---
/*
 * CommandBlock — 可複製的終端指令區塊（Cloudflare docs 常見的 npm/CLI 指令樣式）。
 *
 * 用法：
 *   <CommandBlock command="gitface use work" />
 *   <CommandBlock>gitface apply --json</CommandBlock>   {/* slot 亦可 *\/}
 *
 * prop 優先於 slot；複製按鈕以 data-command 為主、fallback 讀 <code> 文字。
 */
interface Props {
	command?: string;
}
const { command } = Astro.props;
---

<div class="gf-command" data-command={command ?? ""}>
	<div class="gf-command__body">
		<span class="gf-command__prompt" aria-hidden="true">$</span>
		<code>{command ?? <slot />}</code>
	</div>
	<button class="gf-command__copy" type="button" aria-label="複製指令">
		<span class="gf-command__copy-label">複製</span>
	</button>
</div>

<style>
	.gf-command {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin: 1rem 0;
		padding: 0.625rem 0.75rem 0.625rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: var(--radius-control, 0.5rem);
		background: var(--sl-color-gray-6);
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		overflow-x: auto;
	}

	.gf-command__body {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		min-width: 0;
	}

	.gf-command__prompt {
		color: var(--sl-color-accent);
		font-weight: 700;
		flex-shrink: 0;
	}

	.gf-command code {
		background: none;
		border: none;
		padding: 0;
		color: var(--sl-color-white);
		white-space: pre;
	}

	.gf-command__copy {
		position: relative;
		flex-shrink: 0;
		padding: 0.25rem 0.625rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		background: var(--sl-color-black);
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xs);
		font-family: var(--sl-font);
		cursor: pointer;
		transition:
			border-color 0.15s ease,
			color 0.15s ease,
			scale 0.1s ease;
	}

	/* 視覺鈕小於 40px，用 pseudo 撐到 40x40 最小點擊區 */
	.gf-command__copy::before {
		content: "";
		position: absolute;
		inset: 50% 50%;
		min-width: 40px;
		min-height: 40px;
		width: 100%;
		height: 100%;
		transform: translate(-50%, -50%);
	}

	.gf-command__copy:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-accent);
	}

	.gf-command__copy:active {
		scale: 0.96; /* 按壓觸感，固定 0.96 */
	}

	.gf-command.is-copied .gf-command__copy-label::after {
		content: " ✓";
		color: var(--sl-color-accent);
	}
</style>

<script>
	document.querySelectorAll<HTMLDivElement>(".gf-command").forEach((el) => {
		const btn = el.querySelector<HTMLButtonElement>(".gf-command__copy");
		if (!btn) return;
		btn.addEventListener("click", async () => {
			const text =
				el.dataset.command?.trim() ||
				el.querySelector("code")?.textContent?.trim() ||
				"";
			if (!text) return;
			try {
				await navigator.clipboard.writeText(text);
				el.classList.add("is-copied");
				setTimeout(() => el.classList.remove("is-copied"), 1500);
			} catch {
				/* clipboard 不可用時忽略 */
			}
		});
	});
</script>
